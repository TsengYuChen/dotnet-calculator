#!/usr/bin/env bash
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

bash scripts/check-secrets.sh --staged

expected="$(tr -d '[:space:]' < .gitleaks-version)"
install_hint="Install gitleaks ${expected}: https://github.com/gitleaks/gitleaks/releases/tag/v${expected}"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "ERROR: gitleaks is not installed. ${install_hint}" >&2
  exit 1
fi

actual="$(gitleaks version 2>/dev/null | tr -d '[:space:]v')"
if [[ "$actual" != "$expected" ]]; then
  echo "ERROR: gitleaks version '${actual}' does not match .gitleaks-version '${expected}'. ${install_hint}" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --config .gitleaks.toml

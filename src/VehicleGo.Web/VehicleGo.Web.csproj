<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Web references Application (handlers) and Infrastructure (only to compose dependencies) (D-T1):
    controllers, OIDC + cookie sign-in, allowlist check, CSRF, ProblemDetails, health checks,
    static files and the SPA fallback. No test-only sign-in endpoint lives here (Technical Plan §2).
  -->
  <PropertyGroup>
    <RootNamespace>VehicleGo.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../VehicleGo.Application/VehicleGo.Application.csproj" />
    <ProjectReference Include="../VehicleGo.Infrastructure/VehicleGo.Infrastructure.csproj" />
  </ItemGroup>

</Project>

# Copy to .env (never commit .env) and fill in real values. ./deploy.sh refuses to run without .env.
# Every variable of the design's environment variable table is listed here; the last three are
# not set in .env (compose / deploy.sh provide them).

# Login allowlist: comma separated; each entry is trimmed and lower-cased before comparison.
# Empty = every login is rejected (the api logs a warning at start-up).
ALLOWED_EMAILS=alice@example.com,bob@example.com

# Google OIDC (from Google Cloud Console > APIs & Services > Credentials, "Web application" client).
# Authorized redirect URIs: http://localhost:8080/signin-oidc and http://localhost:5173/signin-oidc
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret

# Database account (used by the db service; compose builds ConnectionStrings__Default from these)
POSTGRES_USER=vehiclego
# Generate a random password, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=vehiclego

# Base64-encoded 32 random bytes used to derive encryption keys.
# Generate with: openssl rand -base64 32
MASTER_KEY=replace-with-output-of-openssl-rand-base64-32

# --- Not set here ---
# ConnectionStrings__Default  composed by docker-compose.yml from POSTGRES_*
# GIT_SHA                     exported by deploy.sh (git commit, "-dirty" with uncommitted changes)
# POSTGRES_IMAGE              exported by deploy.sh from postgres-image.txt

# Copy to .env (never commit .env) and fill in real values.

# Login allowlist: comma separated; each entry is trimmed and lower-cased before comparison.
ALLOWED_EMAILS=alice@example.com,bob@example.com

# Google OIDC (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database account (used by the db service; compose builds ConnectionStrings__Default from these)
POSTGRES_USER=vehiclego
# Generate a random password, e.g. `openssl rand -base64 24`
POSTGRES_PASSWORD=
POSTGRES_DB=vehiclego

# Base64-encoded 32 random bytes used to derive encryption keys.
# Generate with: openssl rand -base64 32
MASTER_KEY=
